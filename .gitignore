# Virtual environments
venv/
.venv/

# Python bytecode / caches
__pycache__/
*.pyc
.pytest_cache/

# Packaging
*.egg-info/
build/
dist/
*.pyz

# Project-local caches and private fixtures
.claudeglass-cache/
tests/fixtures/_private/

# Agent worktrees (created per concurrent-writer session; never committed)
.claude/worktrees/

# Development dashboard store (serve --store .claude/dev-service.db): built
# from your own history, never committed
.claude/dev-service.db*

# Claude desktop app preview config (starts that dev dashboard; Windows paths)
.claude/launch.json

# Playwright MCP screenshots and snapshots
.playwright-mcp/

# A design tool's cache (it turns up under service/static/ too): may hold
# local paths, never committed
.impeccable/
